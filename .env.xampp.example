# Configuración de ejemplo para usar el CRM en XAMPP con MySQL
# Copia estas variables a tu .env (o renombra este archivo y ajusta)

APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:NcN0Z3FOedeMGFQYZDWIskPVY5Ng1p1U2AaHrvBAkg8=
APP_DEBUG=true
# OBLIGATORIO en XAMPP: misma URL que uses en el navegador (ruta hasta /public).
# Si APP_URL no coincide, rutas firmadas (ej. /entrar/{usuario}) fallan con "Firma no válida".
APP_URL=http://localhost/CRMnv/public

# Zona horaria: define qué día es “hoy” para cumpleaños (mes/día del contacto = hoy local).
APP_TIMEZONE=America/Mexico_City
BIRTHDAY_NOTIFY_TIME=08:00

# Base de datos MySQL (XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_nv
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Fotos de perfil (/storage/...): una vez, en la carpeta del proyecto:
#   php artisan storage:link
