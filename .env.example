APP_NAME="CE CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Sin subcarpeta: http://localhost  |  XAMPP en htdocs/CRMnv: http://localhost/CRMnv/public
APP_URL=http://localhost/CRMnv/public

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

# Zona horaria para “hoy” (cumpleaños, recordatorios). Ej.: America/Mexico_City
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Administrador inicial (php artisan db:seed). Con $ o espacios, usar comillas dobles.
ADMIN_EMAIL=admin@cceconsultoria.com
ADMIN_PASSWORD="admin@Olivia$"
ADMIN_NAME=Administrador

ADMIN_EMAIL_2=olivia.gallardo@ceconsultoriaempresarial.com
ADMIN_PASSWORD_2="G7!vQ#92xL@pR4$ZtK8&"
ADMIN_NAME_2="Olivia Gallardo"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file evita la tabla sessions; database si ya migraste (sesiones en BD).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync en desarrollo evita tabla jobs; en producción suele usarse database o redis.
QUEUE_CONNECTION=sync

# Hora local (APP_TIMEZONE) para enviar avisos de cumpleaños de contactos ese mismo día
BIRTHDAY_NOTIFY_TIME=08:00

# file no requiere tabla `cache`; database si ejecutaste php artisan migrate (Laravel 11+).
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = no envía correo real (solo escribe en storage/logs). Para producción use smtp y complete HOST/USER/PASS.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Ejemplo SMTP: MAIL_MAILER=smtp MAIL_HOST=smtp.tuproveedor.com MAIL_PORT=587 MAIL_USERNAME=... MAIL_PASSWORD=... MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
