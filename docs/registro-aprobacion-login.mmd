%%{init: {'flowchart': {'nodeSpacing': 24, 'rankSpacing': 30, 'padding': 8, 'curve': 'basis'}, 'themeVariables': {'fontSize': '11px'}}}%%
flowchart TD
    %% Estilo tipo diagrama técnico: acciones rosas, decisiones borde azul
    classDef accion fill:#ffd6d6,stroke:#222222,stroke-width:1.5px,color:#111111
    classDef decision fill:#ffffff,stroke:#1a5fb4,stroke-width:2.5px,color:#111111
    classDef terminal fill:#ffe8d6,stroke:#222222,stroke-width:1.5px,color:#111111

    A([Invitado entra a /register]):::terminal
    B[Llena formulario: nombre, correo, contraseña]:::accion
    C{¿Validación OK?<br/>correo único, formato, contraseña?}:::decision
    D[Mostrar errores<br/>ej. correo ya existe]:::accion
    E[Crear usuario en BD<br/>approval_status = pendiente]:::accion
    F[Asignar rol usuario]:::accion
    G[Disparar evento Registered<br/>verificación de email si aplica]:::accion
    H[Guardar sesión pending_approval_user_id]:::accion
    I([Redirigir a vista<br/>Registro pendiente]):::terminal
    J([Usuario va a /login]):::terminal
    K[Ingresa correo y contraseña]:::accion
    L{¿Credenciales válidas?}:::decision
    M[Mensaje: credenciales incorrectas]:::accion
    N{¿Es admin O<br/>cuenta aprobada?}:::decision
    O[Cerrar sesión]:::accion
    P[Mensaje: pendiente de aprobación]:::accion
    Q[Regenerar sesión]:::accion
    R{¿Usuario es admin?}:::decision
    S([Dashboard administrador]):::terminal
    T([Dashboard usuario]):::terminal

    A --> B --> C
    C -->|Sí| E
    C -.->|No| D
    D --> B
    E --> F --> G --> H --> I --> J
    J --> K --> L
    L -->|Sí| N
    L -.->|No| M
    M --> J
    N -->|Sí| Q
    N -.->|No| O
    O --> P
    P --> J
    Q --> R
    R -->|Sí| S
    R -->|No| T
